{
  "name": "transporte-personal",
  "version": "1.0.1",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/update-version.js && ng serve",
    "build": "node scripts/update-version.js && ng build --configuration=production && node scripts/register-deployment.js",
    "build:prod": "node scripts/update-version.js && ng build --configuration=production && node scripts/register-deployment.js",
    "build:dev": "node scripts/update-version.js && ng build --configuration=development && node scripts/register-deployment.js --skip",
    "build:no-register": "node scripts/update-version.js && ng build --configuration=production",
    "register-deployment": "node scripts/register-deployment.js",
    "update-version": "node scripts/update-version.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "version:patch": "node scripts/version-patch.js",
    "version:minor": "node scripts/version-minor.js",
    "version:major": "node scripts/version-major.js",
    "version:check": "type src/assets/version.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.32",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@primeuix/themes": "^2.0.3",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "dexie": "^4.4.6",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "leaflet": "^1.9.4",
    "primeicons": "^8.0.2",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.10",
    "@angular/cli": "^20.3.10",
    "@angular/compiler-cli": "^20.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.12",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.2"
  }
}